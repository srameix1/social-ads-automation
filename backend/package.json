{
  "name": "spotflow-backend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "db:migrate": "node database/migrate.js",
    "db:seed": "node database/seed.js",
    "db:reset": "node database/migrate.js && node database/seed.js",
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc",
    "postbuild": "node scripts/copy-assets.js",
    "start": "node dist/server.js",
    "test:gemini": "ts-node --transpile-only scripts/test-gemini.ts",
    "test:cliente-real": "node test/prueba-cliente-real.js",
    "test:3-planes": "node test/prueba-3-planes.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.27.0",
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@fontsource/bebas-neue": "^5.2.7",
    "@fontsource/oswald": "^5.2.8",
    "@fontsource/playfair-display": "^5.2.8",
    "@fontsource/roboto-condensed": "^5.2.8",
    "@types/fluent-ffmpeg": "^2.1.28",
    "@types/node-cron": "^3.0.11",
    "bcrypt": "^5.1.1",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-validator": "^7.1.0",
    "fluent-ffmpeg": "^2.1.3",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^4.6.0",
    "pg": "^8.12.0",
    "pg-boss": "^12.26.1",
    "resend": "^6.12.4",
    "sharp": "^0.34.5",
    "stripe": "^22.2.0",
    "uuid": "^10.0.0",
    "winston": "^3.13.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.14.0",
    "@types/pg": "^8.11.6",
    "@types/uuid": "^10.0.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.5"
  }
