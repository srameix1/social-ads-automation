# ─────────────────────────────────────────────
# Base de datos
# ─────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=social_ads_db
DB_USER=social_ads_user
DB_PASSWORD=changeme

# pgAdmin (solo desarrollo local)
PGADMIN_EMAIL=admin@local.dev
PGADMIN_PASSWORD=changeme

# ─────────────────────────────────────────────
# JWT
# ─────────────────────────────────────────────
# Genera con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=REEMPLAZA_CON_64_BYTES_ALEATORIOS_HEX
JWT_EXPIRES_IN=7d

# ─────────────────────────────────────────────
# Cifrado AES-256-GCM
# AES-256 requiere exactamente 32 bytes = 64 caracteres hex
# Genera con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ─────────────────────────────────────────────
ENCRYPTION_KEY=REEMPLAZA_CON_32_BYTES_ALEATORIOS_HEX_64_CHARS

# ─────────────────────────────────────────────
# Claude API (Anthropic)
# ─────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-api03-...

# ─────────────────────────────────────────────
# Google Gemini — generación de imágenes publicitarias (1er intento)
# Modelo: gemini-3.1-flash-image-preview
# Obtén tu clave en: https://aistudio.google.com/apikey
# ─────────────────────────────────────────────
GEMINI_API_KEY=AIzaSy...tu-clave-aqui

# ─────────────────────────────────────────────
# Replicate — mejora de fotos con Real-ESRGAN (solo Plan Premium)
# Obtén tu token en: https://replicate.com/account/api-tokens
# ─────────────────────────────────────────────
REPLICATE_API_TOKEN=r8_...tu-token-aqui

# ─────────────────────────────────────────────
# OpenAI — generación de imágenes publicitarias (fallback de Gemini)
# Modelo: dall-e-3 (quality: standard)
# Obtén tu clave en: https://platform.openai.com/api-keys
# ─────────────────────────────────────────────
OPENAI_API_KEY=sk-proj-...tu-clave-aqui

# ─────────────────────────────────────────────
# Serper.dev — Research Agent (búsqueda web pre-copy)
# El agente investiga tendencias del nicho antes de generar estrategias.
# Sin esta key el copy se genera igual, sin investigación previa.
# Costo: $0.001/búsqueda · 2 500 búsquedas gratis al registrarte.
# Obtén tu key en: https://serper.dev → Dashboard → API Key
# ─────────────────────────────────────────────
SERPER_API_KEY=

# ─────────────────────────────────────────────
# KIE.ai — Video generation (Grok text-to-video / image-to-video)
# Grok: Plan Premium (best quality reel) + Plan Professional (animated video)
# Get your key at: https://kie.ai
# ─────────────────────────────────────────────
KIE_API_KEY=

# ─────────────────────────────────────────────
# NanaBanana — placeholder hasta tener la API
# ─────────────────────────────────────────────
NANABANANA_API_URL=https://api.nanabanana.com
NANABANANA_API_KEY=your-nanabanana-api-key

# ─────────────────────────────────────────────
# Servidor
# ─────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# URL del frontend (para CORS)
FRONTEND_URL=http://localhost:3000

# ─────────────────────────────────────────────
# Almacenamiento de fotos del negocio
# ─────────────────────────────────────────────
UPLOADS_DIR=./uploads
MAX_FILE_SIZE_MB=10

# URL pública del backend (para OAuth redirect_uri)
BACKEND_URL=http://localhost:4000

# ─────────────────────────────────────────────
# Meta (Facebook + Instagram) OAuth
# Crea una app en: https://developers.facebook.com
# Permisos: pages_manage_posts, pages_read_engagement,
#           instagram_business_basic, instagram_business_content_publish, pages_show_list
# ─────────────────────────────────────────────
FACEBOOK_APP_ID=tu-app-id
FACEBOOK_APP_SECRET=tu-app-secret

# ─────────────────────────────────────────────
# TikTok OAuth (Login Kit)
# Crea una app en: https://developers.tiktok.com
# ─────────────────────────────────────────────
TIKTOK_CLIENT_KEY=tu-client-key
TIKTOK_CLIENT_SECRET=tu-client-secret

# ─────────────────────────────────────────────
# Resend — Transactional email (verificación de cuenta, etc.)
# Obtén tu clave en: https://resend.com/api-keys
# Para pruebas locales usa: onboarding@resend.dev como remitente
# ─────────────────────────────────────────────
RESEND_API_KEY=re_...tu-api-key-aqui

# ─────────────────────────────────────────────
# Stripe
# Crea los productos/precios en: https://dashboard.stripe.com/products
# ─────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# IDs de precios de Stripe (de tipo "recurring")
STRIPE_PRICE_BASIC=price_...
STRIPE_PRICE_PROFESSIONAL=price_...
STRIPE_PRICE_PREMIUM=price_...

# ─────────────────────────────────────────────
# Telegram — alertas de cortesías por vencer
# Crea un bot con @BotFather y obtén tu chat_id con @userinfobot
# ─────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
