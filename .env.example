# ─────────────────────────────────────────────
# Base de datos
# ─────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=social_ads_db
DB_USER=social_ads_user
DB_PASSWORD=changeme

# pgAdmin (solo desarrollo local)
PGADMIN_EMAIL=admin@local.dev
PGADMIN_PASSWORD=changeme

# ─────────────────────────────────────────────
# JWT
# ─────────────────────────────────────────────
# Genera con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=REEMPLAZA_CON_64_BYTES_ALEATORIOS_HEX
JWT_EXPIRES_IN=7d

# ─────────────────────────────────────────────
# Cifrado AES-256-GCM
# AES-256 requiere exactamente 32 bytes = 64 caracteres hex
# Genera con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ─────────────────────────────────────────────
ENCRYPTION_KEY=REEMPLAZA_CON_32_BYTES_ALEATORIOS_HEX_64_CHARS

# ─────────────────────────────────────────────
# Claude API (Anthropic)
# ─────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-api03-...

# ─────────────────────────────────────────────
# Google Gemini — generación de imágenes publicitarias
# Modelo: gemini-3.1-flash-image-preview
# Obtén tu clave en: https://aistudio.google.com/apikey
# ─────────────────────────────────────────────
GEMINI_API_KEY=AIzaSy...tu-clave-aqui

# ─────────────────────────────────────────────
# NanaBanana — placeholder hasta tener la API
# ─────────────────────────────────────────────
NANABANANA_API_URL=https://api.nanabanana.com
NANABANANA_API_KEY=your-nanabanana-api-key

# ─────────────────────────────────────────────
# Servidor
# ─────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# URL del frontend (para CORS)
FRONTEND_URL=http://localhost:3000

# ─────────────────────────────────────────────
# Almacenamiento de fotos del negocio
# ─────────────────────────────────────────────
UPLOADS_DIR=./uploads
MAX_FILE_SIZE_MB=10
